{
  "name": "tempmail",
  "version": "1.0.0",
  "private": true,
  "description": "Temporary email service - Full Cloudflare (Worker + D1 + Pages)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create tempmail-db",
    "db:migrate": "wrangler d1 execute tempmail-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute tempmail-db --file=schema.sql --local"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
